{
  "librechatVersion": "968950a",
  "authLoginKeys": ["token", "user"],
  "chatStartKeys": [
    "conversationId",
    "generationCreatedAt",
    "generationProtocolVersion",
    "status",
    "streamId"
  ],
  "generationProtocolVersion": 1,
  "generationProtocolHeader": "1",
  "streamContentType": "text/event-stream",
  "streamEventTypes": [
    "created",
    "final",
    "on_context_usage",
    "on_message_delta",
    "on_run_step",
    "on_run_step_closed"
  ],
  "assistantMessageShape": {
    "hasContentArray": true,
    "firstPartType": "text"
  },
  "routes": {
    "GET /api/config": 200,
    "POST /api/auth/login": 200,
    "GET /api/endpoints": 200,
    "POST /api/agents/chat/:endpoint": 200,
    "GET /api/agents/chat/stream/:id": 200,
    "GET /api/messages/:conversationId": 200,
    "GET /api/convos": 200
  }
}
